{
  "name": "@docx4j/editor-mcp",
  "version": "0.3.0",
  "description": "The MCP companion for @docx4j/editor: one local process serving the editor, its co-editing relay and MCP tools, so that an agent edits a document in a room beside a person, every edit a tracked change waiting for a decision.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plutext/docx4j-editor.git",
    "directory": "packages/editor-mcp"
  },
  "homepage": "https://github.com/plutext/docx4j-editor/tree/main/packages/editor-mcp#readme",
  "bugs": {
    "url": "https://github.com/plutext/docx4j-editor/issues"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "docx4j-editor-mcp": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-app.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "node ../../scripts/check-licences.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@docx4j/core-ts": "^0.9.0",
    "@docx4j/editor-model": "^0.3.0",
    "@docx4j/editor-relay": "^0.3.0",
    "@docx4j/generated-objects-ts": "^0.9.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "prosemirror-model": "^1.25.0",
    "ws": "^8.21.3",
    "yjs": "^13.6.33",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@hocuspocus/provider": "^3.4.4",
    "@types/node": "^20.19.43",
    "@types/ws": "^8.18.1"
  }
}
