// ED-005 section 12.122: a save as Flat OPC (Word's "Word XML Document", one `pkg:package` XML document) writes the parts a
// zip save writes, each XML part's text as the zip holds it, and its self-check reads the Flat OPC it wrote.
import { describe, test, expect } from 'vitest';
import { unzipSync, strFromU8 } from 'fflate';
import { WordprocessingMLPackage } from '@docx4j/core-ts';
import { EditorDocument, runCommand } from '../src/index.mjs';
import { allFixtures, fixture } from './helpers.mjs';

const names = await allFixtures();

/** The declaration a part's text loses inside `pkg:xmlData`, as the engine strips it. */
const withoutDeclaration = (text: string): string => text.replace(/^﻿?\s*<\?xml[^>]*\?>\s*/, '');

/** A Flat OPC document's parts by name: an XML part's text, a binary part's bytes. */
function partsOf(flat: string): Map<string, { xml: string } | { binary: Uint8Array }> {
  const out = new Map<string, { xml: string } | { binary: Uint8Array }>();
  for (const piece of flat.split('<pkg:part ').slice(1)) {
    const name = /^pkg:name="([^"]*)"/.exec(piece)![1]!.replace(/^\//, '');
    const xml = /<pkg:xmlData>([\s\S]*)<\/pkg:xmlData><\/pkg:part>/.exec(piece);
    if (xml) { out.set(name, { xml: xml[1]! }); continue; }
    const b64 = /<pkg:binaryData>([\s\S]*)<\/pkg:binaryData><\/pkg:part>/.exec(piece)![1]!.replace(/\s+/g, '');
    out.set(name, { binary: Uint8Array.from(Buffer.from(b64, 'base64')) });
  }
  return out;
}

/** Each part of a zip against the Flat OPC's: the names, and each part's text or bytes; `[Content_Types].xml` travels on the parts. */
function expectSameParts(zip: Uint8Array, flat: string): void {
  const entries = unzipSync(zip);
  const parts = partsOf(flat);
  expect([...parts.keys()].sort()).toEqual(Object.keys(entries).filter((n) => n !== '[Content_Types].xml').sort());
  for (const [name, part] of parts) {
    if ('xml' in part) expect(part.xml, name).toBe(withoutDeclaration(strFromU8(entries[name]!)));
    else expect(Buffer.compare(Buffer.from(part.binary), Buffer.from(entries[name]!)), name).toBe(0);
  }
}

describe('a save as Flat OPC (ED-005 section 12.122)', () => {
  test.each(names)('%s, untouched: the self-check passes over the Flat OPC, and every part is the zip save\'s', async (name) => {
    const session = await EditorDocument.open(await fixture(name), { repair: 'word' });
    const saved = await session.save({ format: 'flatOpc' });
    expect(saved.selfCheck?.equal).toBe(true);
    const flat = new TextDecoder().decode(saved.bytes);
    expect(flat.startsWith('<?xml version="1.0" standalone="yes"?><?mso-application progid="Word.Document"?><pkg:package xmlns:pkg="http://schemas.microsoft.com/office/2006/xmlPackage">')).toBe(true);
    // The zip save's parts, which roundtrip.test.mts holds to the source's but for the relationships parts, regenerated by design,
    // and a repaired file's repaired places (core-ts 0.7.0).
    expectSameParts((await session.save()).bytes, flat);
  });

  test('edited: the parts are the zip save\'s, and the Flat OPC reads back with the edit', async () => {
    const session = await EditorDocument.open(await fixture('HelloWordOnline.docx'));
    let from = 0;
    session.doc.forEach((node, pos) => { if (from === 0 && node.textContent.length > 10) from = pos + 1; });
    expect(runCommand(session, 'font.bold', { value: true }, { from, to: from + 5 }).ok).toBe(true);
    expect(runCommand(session, 'insertText', { text: ' Saved as Flat OPC.' }, { from: from + 5 }).ok).toBe(true);
    const flat = new TextDecoder().decode((await session.save({ format: 'flatOpc' })).bytes);
    expectSameParts((await session.save()).bytes, flat);
    const reloaded = await EditorDocument.open(await WordprocessingMLPackage.load(flat));
    expect(reloaded.doc.textContent).toContain(' Saved as Flat OPC.');
    expect(strFromU8(unzipSync((await session.save()).bytes)['docProps/app.xml']!)).toContain('docx4j-editor');
  });

  test('the self-check reads what was written: a Flat OPC that does not read back as the document is refused', async () => {
    const session = await EditorDocument.open(await fixture('HelloWordOnline.docx'));
    const flat = new TextDecoder().decode((await session.save({ format: 'flatOpc', selfCheck: false })).bytes);
    const changed = new TextEncoder().encode(flat.replace(/<w:t>([^<]{3,})<\/w:t>/, '<w:t>$1, altered</w:t>'));
    expect((await session.selfCheck(changed)).equal).toBe(false);
  });
});
