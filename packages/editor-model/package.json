{
  "name": "@docx4j/editor-model",
  "version": "0.3.0",
  "description": "The headless editable projection of a docx over @docx4j/core-ts: a ProseMirror schema, import from and export to the typed tree with the original elements preserved, held in a Yjs document. Runs in Node and the browser; the editor UI is @docx4j/editor.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plutext/docx4j-editor.git",
    "directory": "packages/editor-model"
  },
  "homepage": "https://github.com/plutext/docx4j-editor/tree/main/packages/editor-model#readme",
  "bugs": {
    "url": "https://github.com/plutext/docx4j-editor/issues"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:zones": "for tz in UTC Australia/Brisbane America/New_York Asia/Kolkata; do echo \"TZ=$tz\"; TZ=$tz vitest run test/track.test.mts test/revisions.test.mts test/revisions-export.test.mts test/review-listing.test.mts test/review.test.mts test/preserved.test.mts test/agreement.test.mts test/concurrency.test.mts test/comments.test.mts || exit 1; done",
    "test:watch": "vitest",
    "prepack": "node ../../scripts/check-licences.mjs"
  },
  "dependencies": {
    "@docx4j/core-ts": "^0.9.0",
    "@docx4j/generated-objects-ts": "^0.9.1",
    "@xmldom/xmldom": "^0.9.7",
    "fontoxpath": "^3.34.0",
    "lib0": "^0.2.99",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm-strikethrough": "^2.0.1",
    "mdast-util-gfm-table": "^2.0.0",
    "micromark-extension-gfm-strikethrough": "^2.1.0",
    "micromark-extension-gfm-table": "^2.1.2",
    "prosemirror-changeset": "^2.4.4",
    "prosemirror-model": "^1.25.0",
    "prosemirror-state": "^1.4.3",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.10.0",
    "xpath": "^0.0.34",
    "y-prosemirror": "^1.3.7",
    "yjs": "^13.6.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.17.0",
    "fflate": "^0.8.2",
    "jsdom": "^26.1.0",
    "prosemirror-view": "^1.40.0"
  },
  "engines": {
    "node": ">=22"
  }
}
