//
// Links (ED-003 section 5.5, step C4): one command in Office JS's shape, `range.hyperlink`,
// over the selection, the link at the caret, or text inserted at a caret. The `link` mark stays
// as E1 made it (`sourceId`, `rId`, `anchor`; non-inclusive): a target is a relationship or an
// anchor, both references. An external address becomes a relationship of the main part in the
// command's `prepare` half, through the engine's relationships part (the same call the engine's
// own `Range.hyperlink` makes); the relationships part is regenerated by design, so nothing is
// marked and undo takes the mark off and leaves the relationship. A mark with no `sourceId`
// exports as a new `w:hyperlink` holder (export.mts). Word's edge rule is the mark's
// non-inclusiveness (section 9 item 19): typing at the end leaves the link, typing inside
// extends it. A link's text takes Word's look, the `Hyperlink` character style in place of any
// other and no direct colour, and loses the style when the link goes, as the engine's setter does
// since core-ts 0.2.1 (CR-002 section 25); the style's definition is added in `prepare` when the
// document lacks it. A range over part of a link follows Word (core-ts 0.2.2, check 16; ED-005
// section 1.6): every link it touches goes whole, one whose edge it crosses is taken into the new
// link, one it lies inside leaves its outside text plain, and removing part of a link removes all.
// A web address pasted as plain text is linked by the same rules (`insertLinkedText`, ED-005 section 12.121).
import type { Command, EditorState, Transaction } from 'prosemirror-state';
import { TextSelection } from 'prosemirror-state';
import type { Mark, Node as PMNode, ResolvedPos } from 'prosemirror-model';
import type { Element } from '@docx4j/core-ts';
import type * as wml from '@docx4j/generated-objects-ts/modules/org_docx4j_wml';
import type { EditorDocument } from '../session.mjs';
import { register, sessionOf } from './spec.mjs';
import { applyMarkChangeIn, setFontField, withMark, withoutMark, type MarkChange } from './marks.mjs';

/** Office JS `range.hyperlink`'s arguments: an address, a place in the document (a bookmark's name), the text for a caret. */
export interface HyperlinkArgs {
  address?: string;
  subAddress?: string;
  text?: string;
  /** Filled in by the command: the relationship made for `address`. */
  rId?: string;
}

/** A link on the page: its extent, its references, and the address its relationship resolves to. */
export interface LinkReading {
  from: number;
  to: number;
  rId: string | null;
  anchor: string | null;
  address: string;
  text: string;
}

const isLink = (m: Mark): boolean => m.type.name === 'link';

/** The character style Word gives the text of a link it makes. */
export const HYPERLINK_STYLE = 'Hyperlink';

/** A link's look: the `Hyperlink` character style in place of any other, and no direct colour; the rest of the direct formatting stays. */
const linkLook: MarkChange = (marks, schema) => setFontField('color', null)(withMark(marks, schema.marks['runStyle']!.create({ id: HYPERLINK_STYLE })), schema);

/** A link's look taken off: the `Hyperlink` style where the text has it (the colour it lost does not come back, as in the engine). */
const withoutLinkLook: MarkChange = (marks, schema) => {
  const type = schema.marks['runStyle']!;
  return marks.some((m) => m.type === type && m.attrs['id'] === HYPERLINK_STYLE) ? withoutMark(marks, type) : marks;
};

/** The address a link's relationship targets, or '' (an anchor-only link, or none). */
export function hyperlinkTarget(session: EditorDocument | undefined, rId: string | null): string {
  if (!session || !rId) return '';
  return session.main.relationshipsPart?.getRelationshipById(rId)?.target ?? '';
}

/** The link mark at a position: on the text after it, else on the text before it (a caret at the end of a link is still in it for editing). */
function linkMarkAt($pos: ResolvedPos): Mark | undefined {
  const after = $pos.nodeAfter?.marks.find(isLink);
  if (after) return after;
  return $pos.nodeBefore?.marks.find(isLink);
}

/** The extent of the link `mark` around `pos` within its paragraph: every adjacent inline node carrying an equal mark. */
function linkExtent(doc: PMNode, pos: number, mark: Mark): { from: number; to: number } {
  const $pos = doc.resolve(pos);
  const parent = $pos.parent;
  const start = $pos.start();
  let from = pos;
  let to = pos;
  let at = start;
  const pieces: { from: number; to: number; linked: boolean }[] = [];
  parent.forEach((child) => {
    pieces.push({ from: at, to: at + child.nodeSize, linked: child.marks.some((m) => m.eq(mark)) });
    at += child.nodeSize;
  });
  const index = pieces.findIndex((p) => p.linked && p.from <= pos && pos <= p.to);
  if (index < 0) return { from, to };
  let i = index;
  while (i > 0 && pieces[i - 1]!.linked) i--;
  from = pieces[i]!.from;
  let j = index;
  while (j < pieces.length - 1 && pieces[j + 1]!.linked) j++;
  to = pieces[j]!.to;
  return { from, to };
}

/** Every link a range touches (overlaps), each with its whole extent. */
function linksTouching(doc: PMNode, range: { from: number; to: number }): { from: number; to: number; mark: Mark }[] {
  const out: { from: number; to: number; mark: Mark }[] = [];
  doc.nodesBetween(range.from, range.to, (node, pos) => {
    if (!node.isInline) return true;
    for (const m of node.marks) {
      if (isLink(m) && !out.some((o) => o.mark.eq(m) && o.from <= pos && pos < o.to)) out.push({ ...linkExtent(doc, pos, m), mark: m });
    }
    return false;
  });
  return out.filter((o) => o.from < range.to && o.to > range.from);
}

/** The link the selection is in (a caret in or at the end of one, or a selection starting in one), for the dialog and the tooltip. */
export function linkAt(state: EditorState): LinkReading | undefined {
  const { $from } = state.selection;
  const mark = linkMarkAt($from);
  if (!mark) return undefined;
  const { from, to } = linkExtent(state.doc, $from.pos, mark);
  const rId = (mark.attrs['rId'] as string | null) ?? null;
  const anchor = (mark.attrs['anchor'] as string | null) ?? null;
  return { from, to, rId, anchor, address: hyperlinkTarget(sessionOf(state), rId), text: state.doc.textBetween(from, to, '\t') };
}

/** The document's bookmarks, in order, with where each starts: the targets a link can have (the opaque `bookmarkStart` items). */
export function documentBookmarks(doc: PMNode, session: EditorDocument): { name: string; pos: number }[] {
  const out: { name: string; pos: number }[] = [];
  doc.descendants((node, pos) => {
    if (node.type.name !== 'opaqueInline' || node.attrs['kind'] !== 'bookmarkStart') return !node.isLeaf;
    const el = session.ctx.ids.get(node.attrs['sourceId'] as string) as Element<wml.CTBookmark> | undefined;
    const name = el?.value.name;
    if (typeof name === 'string' && name !== '' && !name.startsWith('_GoBack')) out.push({ name, pos });
    return false;
  });
  return out;
}

/** The range the command works on: the selection, else the link at the caret; undefined for a bare caret. */
function targetRange(state: EditorState): { from: number; to: number } | undefined {
  const { from, to, $from } = state.selection;
  if (from !== to) return { from, to };
  const mark = linkMarkAt($from);
  return mark ? linkExtent(state.doc, from, mark) : undefined;
}

const inParagraph = (state: EditorState): boolean => {
  const { $from, $to } = state.selection;
  return $from.parent.type.name === 'paragraph' && $from.sameParent($to);
};

/**
 * `range.hyperlink`'s rules over `range` in `tr`: every link the range touches goes whole, its text losing the link's look; one
 * whose edge the range crosses is taken into the new link, one the range lies inside is not (Word, core-ts 0.2.2). With a target
 * the range, so widened, is linked in Word's look; with none the links are removed and their text kept. The range linked.
 */
function relink(tr: Transaction, state: EditorState, range: { from: number; to: number }, target: { rId: string | null; anchor: string | null } | null): { from: number; to: number } {
  const type = state.schema.marks['link']!;
  for (const link of linksTouching(tr.doc, range)) {
    tr.removeMark(link.from, link.to, link.mark);
    applyMarkChangeIn(tr, state, link.from, link.to, withoutLinkLook);
    if (target && !(link.from <= range.from && range.to <= link.to)) range = { from: Math.min(range.from, link.from), to: Math.max(range.to, link.to) };
  }
  if (target) {
    tr.removeMark(range.from, range.to, type);
    applyMarkChangeIn(tr, state, range.from, range.to, linkLook);
    tr.addMark(range.from, range.to, type.create({ sourceId: null, rId: target.rId, anchor: target.anchor }));
  }
  return range;
}

/**
 * A pasted web address (ED-005 section 12.121): `text` put over the selection as typing puts it there, in the caret's
 * formatting, then linked to the relationship `rId` by `range.hyperlink`'s rules, so in Word's look; the caret after it.
 * `typing` is the formatting the text took before the link's look. A caret at a link's end is outside the link (its mark is
 * not inclusive) but not outside the `Hyperlink` style, so the caller stores `typing` for what is typed next, which should
 * not look like a link it is not part of.
 */
export function insertLinkedText(state: EditorState, text: string, rId: string): { tr: Transaction; typing: readonly Mark[] } {
  const tr = state.tr.insertText(text);
  const to = tr.selection.from;
  const from = to - text.length;
  const took = tr.doc.nodeAt(from)?.marks ?? [];
  const typing = took.filter((m) => !isLink(m));
  relink(tr, state, { from, to }, { rId, anchor: null });
  // Inside a link the address took its look too; the link is gone from the text around it, and so is the look.
  return { tr, typing: took.some(isLink) ? withoutLinkLook(typing, state.schema) : typing };
}

/**
 * Office JS `range.hyperlink = 'address#subAddress'`, with Word's dialog's fields as the
 * arguments. Over the selection, or the link at the caret (replaced), or at a caret with `text`
 * (inserted, linked). Neither an address nor a place: the link is removed and its text kept.
 */
register<HyperlinkArgs>({
  name: 'range.hyperlink',
  label: 'Hyperlink',
  args: { address: 'a URL or file (external), or nothing', subAddress: "a bookmark's name in this document, or nothing", text: 'the text to insert at a caret' },
  api: ({ address, subAddress, text }) => {
    // The engine's `Range.hyperlink` takes `address#anchor`, and '' removes; a text to insert at a caret is the editor's own.
    const a = address?.trim() ?? '';
    const anchor = subAddress?.trim() ?? '';
    if (text) return undefined;
    return `selection.range.hyperlink = ${JSON.stringify(anchor === '' ? a : `${a}#${anchor}`)};`;
  },
  prepare: async (state, args) => {
    const session = sessionOf(state);
    const address = args.address?.trim() ?? '';
    const anchor = args.subAddress?.trim() ?? '';
    if (!session || (address === '' && anchor === '') || !inParagraph(state)) return args;
    if (!targetRange(state) && !args.text) return args;
    // The style the link's text takes, spliced in when the document lacks it (the engine's setter
    // requires it at the save instead: a setter cannot await).
    await session.ensureStyles([HYPERLINK_STYLE]);
    return address === '' ? args : { ...args, rId: session.addHyperlink(address) };
  },
  run: (args) => (state, dispatch) => {
    if (!inParagraph(state)) return false;
    const address = args.address?.trim() ?? '';
    const anchor = args.subAddress?.trim() ?? '';
    const linking = address !== '' || anchor !== '';
    if (linking && address !== '' && !args.rId) return false;   // the relationship half did not run
    const schema = state.schema;
    const tr = state.tr;
    let range = targetRange(state);
    if (!range) {
      if (!args.text || !linking) return false;
      const at = state.selection.from;
      tr.insertText(args.text, at);
      range = { from: at, to: at + args.text.length };
    } else if (args.text !== undefined && args.text !== '' && args.text !== state.doc.textBetween(range.from, range.to, '\t')) {
      const marks = state.doc.resolve(range.from).marks().filter((m) => !isLink(m));
      tr.replaceWith(range.from, range.to, schema.text(args.text, marks));
      range = { from: range.from, to: range.from + args.text.length };
    }
    range = relink(tr, state, range, linking ? { rId: address !== '' ? args.rId ?? null : null, anchor: anchor !== '' ? anchor : null } : null);
    tr.setSelection(TextSelection.create(tr.doc, range.from, range.to));
    dispatch?.(tr.scrollIntoView());
    return true;
  },
  isEnabled: (state) => inParagraph(state),
  isActive: (state) => linkAt(state) !== undefined,
});

/** The command a Ctrl+click runs: the bookmark a link's anchor names, as a position, or undefined. */
export function bookmarkPosition(state: EditorState, anchor: string): number | undefined {
  const session = sessionOf(state);
  if (!session) return undefined;
  return documentBookmarks(state.doc, session).find((b) => b.name === anchor)?.pos;
}

export type { Command };
